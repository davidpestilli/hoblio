    {
      "id": "log_done",
      "kind": "action",
      "label": "Log done",
      "ui": { "x": 960, "y": 120 },
      "action": {
        "type": "log",
        "message": "Done flag: {done_flag}"
      }
    },
    { "id": "end", "kind": "end", "label": "End", "ui": { "x": 1180, "y": 120 } }
  ],
  "edges": [
    { "from": "start", "to": "run_greet" },
    { "from": "run_greet", "to": "log_greeting" },
    { "from": "log_greeting", "to": "run_finish" },
